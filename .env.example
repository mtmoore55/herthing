# Copy to ~/.config/herthing/environment and chmod 600 that file.
# The development launcher loads it explicitly; systemd uses EnvironmentFile.
HERTHING_HOST=172.16.42.1
HERTHING_PORT=8787
HERTHING_ASSISTANT_PROVIDER=local

# Uncomment only after supplying real values locally.
# HERTHING_LATITUDE=YOUR_LATITUDE
# HERTHING_LONGITUDE=YOUR_LONGITUDE
HERTHING_WEATHER_UNIT=fahrenheit
# HERTHING_CALENDAR_ICS_URL=YOUR_PRIVATE_ICALENDAR_URL
# HERTHING_NOTES_DIR=/absolute/path/to/your/vault

# Existing provider choices: local, meta, muse, muse-browser.
# MODEL_API_KEY=YOUR_META_KEY
# Alternatively, restore ~/.config/muse/auth.json privately.
# HERTHING_MUSE_BROWSER_DEBUG_URL=http://127.0.0.1:9333
# HERTHING_MUSE_BROWSER_CHAT_URL=YOUR_PRIVATE_DEDICATED_CHAT_URL
# HERTHING_MUSE_BROWSER_URL=YOUR_PRIVATE_DEDICATED_CHAT_URL
# HERTHING_MUSE_BROWSER_BINARY=/usr/bin/google-chrome-stable

# Spotify token defaults to ~/.cache/spotify-player/user_client_token.json.
# HERTHING_SPOTIFY_TOKEN_FILE=/absolute/path/to/private/token.json
# Optional Librespot receiver: historical variable name; use the chosen LAN IPv4.
# HERTHING_WIFI_ADDRESS=YOUR_LAN_IPV4

# Unset means use the current default PipeWire output, not the old machine's sink.
# HERTHING_AUDIO_SINK=YOUR_PIPEWIRE_NODE_NAME
# Existing Car Thing microphone control endpoint:
# HERTHING_DEVICE_CONTROL_URL=http://172.16.42.2:8790/cgi-bin/microphone
# Streaming recognizer remains opt-in; batch CPU Whisper is the baseline.
# HERTHING_STREAMING_STT=shadow

[Unit]
Description=HerThing dedicated Muse browser bridge
Documentation=https://github.com/mtmoore55/herthing
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/herthing
Environment=HERTHING_MUSE_BROWSER_PROFILE=%h/.local/share/herthing/muse-browser
Environment=HERTHING_MUSE_BROWSER_DEBUG_PORT=9333
ExecStart=%h/herthing/scripts/start-muse-browser.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target

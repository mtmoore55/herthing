[Unit]
Description=HerThing desktop display
PartOf=graphical-session.target
Wants=herthing-ui.service
After=graphical-session.target herthing-ui.service

[Service]
Type=simple
ExecStart=/usr/bin/google-chrome-stable --user-data-dir=%h/.local/share/herthing/ui-browser --app=http://127.0.0.1:8790/ --no-first-run --no-default-browser-check
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target

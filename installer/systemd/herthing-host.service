[Unit]
Description=HerThing host gateway
Documentation=https://github.com/mtmoore55/herthing
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/herthing
Environment=HERTHING_HOST=172.16.42.1
Environment=HERTHING_PORT=8787
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin
EnvironmentFile=-%h/.config/herthing/environment
ExecStart=%h/.local/share/mise/shims/bun run host/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target

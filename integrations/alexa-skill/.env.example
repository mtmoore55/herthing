# Lambda environment. Use the identical random token on HerThing.
ALEXA_SKILL_ID=amzn1.ask.skill.REPLACE_WITH_SKILL_ID
HERTHING_ENDPOINT=https://ziggy.example.com/api/alexa/conversation
HERTHING_ALEXA_GATEWAY_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
HERTHING_REQUEST_TIMEOUT_MS=6500

# HerThing host environment (~/.config/herthing/environment):
# HERTHING_ALEXA_GATEWAY_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_VALUE
# HERTHING_ALEXA_TIMEOUT_MS=6500
# HERTHING_ALEXA_GATEWAY_PORT=8788
